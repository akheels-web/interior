# Copy to .env.local. Generate distinct strong local passwords and >=48 character auth secret.
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-random-at-least-48-character-secret
DATABASE_URL=postgresql://forma:replace-postgres-password@127.0.0.1:5548/forma
TEST_DATABASE_URL=postgresql://forma:replace-postgres-password@127.0.0.1:5548/forma_test
POSTGRES_PASSWORD=replace-postgres-password
REDIS_PASSWORD=replace-redis-password
REDIS_URL=redis://:replace-redis-password@127.0.0.1:6388
SUPER_ADMIN_EMAIL=admin@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1028
SMTP_FROM=PlanSaathi Local <studio@forma.local>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LOCAL_DEVELOPMENT=true
# Needed only for the gated local seed; remove on production hosting.
NODE_ENV=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Generate a long random value, never commit a real token.
OPS_TOKEN=replace-with-random-at-least-48-character-token
PLAN_STORAGE=local
PLAN_STORAGE_BUDGET_BYTES=8000000000
PUBLIC_INDEXING_ENABLED=false
RAZORPAY_LIVE_APPROVED=false
LAUNCH_POLICIES_APPROVED=false
