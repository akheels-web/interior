{
  "name": "plansaathi-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/copy-pdf-worker.mjs && next build --turbopack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "infra:up": "docker compose --env-file .env.local -f compose.local.yml -p forma-local up -d",
    "infra:stop": "docker compose --env-file .env.local -f compose.local.yml -p forma-local stop",
    "db:migrate": "tsx --env-file=.env.local migrations/runner.ts",
    "dev:seed": "tsx --env-file=.env.local scripts/seed-local.ts",
    "ops:worker": "node --env-file=.env.local scripts/ops-worker.mjs",
    "launch:check": "tsx scripts/check-launch.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "^5.8.2",
    "jspdf": "^4.2.0",
    "lenis": "1.3.27",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.2.3",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
