# Copy to the ignored .env.production on the server, chmod 600. Never copy .env.local.
DOMAIN=plansaathi.com
APP_URL=https://plansaathi.com
BETTER_AUTH_URL=https://plansaathi.com
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://plansaathi:replace-with-url-encoded-password@db:5432/plansaathi
SUPER_ADMIN_EMAIL=grow.lokal1@gmail.com
LOCAL_DEVELOPMENT=false
REDIS_URL=
OPS_TOKEN=
PLAN_STORAGE=r2
PLAN_STORAGE_BUDGET_BYTES=6000000000
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Resend SMTP is one low-budget option. A verified sender domain is required.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=resend
SMTP_PASS=
AUTH_EMAIL_DAILY_LIMIT=80
AUTH_EMAIL_MONTHLY_LIMIT=2200
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Enable these only after provider tests and merchant policy review, respectively.
RAZORPAY_LIVE_APPROVED=false
LAUNCH_POLICIES_APPROVED=false
PUBLIC_INDEXING_ENABLED=false
